# Copy to cloud.env and fill in. cloud.env is gitignored and must stay that way.
# Run `make cloud-check` after editing.

CLOUD_PROVIDER=aws                      # aws | azure | gcp   (local is for development only)
PROJECT_ID=itcs355-<studentid>
REGION=<your nearest region>

# --- capability slots -------------------------------------------------------
# AWS    BLOB_URI=s3://<bucket>/itcs355
#        CONTAINER_REGISTRY=<account>.dkr.ecr.<region>.amazonaws.com/itcs355
# Azure  BLOB_URI=https://<account>.blob.core.windows.net/<container>/itcs355
#        CONTAINER_REGISTRY=<registry>.azurecr.io/itcs355
# GCP    BLOB_URI=gs://<bucket>/itcs355
#        CONTAINER_REGISTRY=<region>-docker.pkg.dev/<project>/itcs355
BLOB_URI=
CONTAINER_REGISTRY=

# Self-hosted MLflow is the portable choice. File-based stores are rejected by
# MLflow 3.x, so use sqlite locally and a database backend on a server.
MLFLOW_TRACKING_URI=sqlite:///mlflow.db

MODEL_REGISTRY_NAME=itcs355-<studentid>
IDENTITY_REF=                           # IAM role ARN | managed identity | service account

BUDGET_LIMIT_THB=800

# --- Azure-only resource references (ignored unless CLOUD_PROVIDER=azure) ---
# These are resource names/IDs, not credentials. Azure CLI authentication comes from `az login`.
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_ML_WORKSPACE=
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONTAINER=
AZURE_ACR_NAME=
AZURE_ML_COMPUTE=                  # optional Azure ML compute target; blank uses serverless
# Existing Consumption environment name and the Lab 3 serving app name.
AZURE_CONTAINERAPP_ENVIRONMENT=
AZURE_CONTAINERAPP_NAME=itcs355-lab3
# Full resource ID of the pre-authorized user-assigned identity (recommended).
AZURE_CONTAINERAPP_IDENTITY=
AZURE_CONTAINERAPP_IDENTITY_NAME=itcs355-lab3-id

# Lab 3 image reference; fill from `make serve-image-push` and keep it digest-pinned.
SERVING_IMAGE_URI=

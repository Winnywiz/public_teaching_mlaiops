{
  "id": null,
  "uid": "itcs355-prediction",
  "title": "ITCS355 Prediction Service",
  "description": "Request health, tail latency, rolling feature statistics, drift, and active model version.",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "Request rate",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "targets": [
        {"expr": "sum(rate(http_requests_total{route=~\"/predict.*\"}[1m]))", "legendFormat": "predictions", "refId": "A"}
      ]
    },
    {
      "id": 2,
      "title": "4xx and 5xx error rate",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []},
      "targets": [
        {
          "expr": "sum by (status_class) (rate(http_requests_total{route=~\"/predict.*\",status_class=~\"4xx|5xx\"}[5m])) / clamp_min(sum(rate(http_requests_total{route=~\"/predict.*\"}[5m])), 1e-9)",
          "legendFormat": "{{status_class}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Prediction latency p50, p95, p99",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 8},
      "fieldConfig": {"defaults": {"unit": "ms"}, "overrides": []},
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(request_latency_ms_bucket{route=~\"/predict.*\"}[5m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(request_latency_ms_bucket{route=~\"/predict.*\"}[5m])))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(request_latency_ms_bucket{route=~\"/predict.*\"}[5m])))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ]
    },
    {
      "id": 4,
      "title": "Recent input distribution: temperature",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "fieldConfig": {"defaults": {"unit": "celsius"}, "overrides": []},
      "targets": [
        {"expr": "feature_rolling_mean{feature=\"temp_c\"}", "legendFormat": "rolling mean, last 500 requests", "refId": "A"},
        {"expr": "feature_rolling_stddev{feature=\"temp_c\"}", "legendFormat": "rolling standard deviation", "refId": "B"}
      ],
      "description": "The service keeps a bounded in-memory window and exposes aggregates only. PSI from the scheduled detector is shown separately."
    },
    {
      "id": 5,
      "title": "Scheduled drift score (PSI)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "fieldConfig": {"defaults": {"unit": "none"}, "overrides": []},
      "targets": [
        {"expr": "drift_psi", "legendFormat": "{{feature}}", "refId": "A"},
        {"expr": "drift_alert_threshold", "legendFormat": "alert threshold", "refId": "B"}
      ]
    },
    {
      "id": 6,
      "title": "Model version in production",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "gridPos": {"h": 5, "w": 24, "x": 0, "y": 24},
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "value_and_name"
      },
      "targets": [
        {"expr": "model_version_info", "legendFormat": "{{model_version}}", "refId": "A"}
      ]
    }
  ],
  "templating": {"list": []},
  "annotations": {"list": []},
  "links": []
}
